// Billing Resolution Agent — Milestone 1 data model.
// One fictional SaaS company ("Lumina Metrics, Inc.") with customer accounts,
// subscriptions, payments, invoices, support tickets, and billing policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum TicketScenario {
  PAID_BUT_INACTIVE_PLAN
  DUPLICATE_INVOICE
  CROSS_ACCOUNT_EXPOSURE
  POSSIBLE_DOUBLE_CHARGE
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Company {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  accounts  Account[]
  policies  Policy[]
}

model Account {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  slug          String        @unique
  name          String
  billingEmail  String
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())

  subscriptions  Subscription[]
  payments       Payment[]
  invoices       Invoice[]
  tickets        Ticket[]       @relation("ReporterTickets")
  relatedTickets Ticket[]       @relation("RelatedTickets")

  @@index([companyId])
}

model Subscription {
  id                 String             @id @default(cuid())
  accountId          String
  account            Account            @relation(fields: [accountId], references: [id])
  key                String             @unique
  planName           String
  status             SubscriptionStatus
  seats              Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([accountId])
}

model Payment {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  ref         String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  method      PaymentMethod
  status      PaymentStatus
  description String?
  occurredAt  DateTime
  createdAt   DateTime      @default(now())

  invoices Invoice[]

  @@index([accountId])
}

model Invoice {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  number      String        @unique
  paymentId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  status      InvoiceStatus
  periodStart DateTime?
  periodEnd   DateTime?
  issuedAt    DateTime
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([accountId])
}

model Ticket {
  id               String         @id @default(cuid())
  reference        String         @unique
  scenario         TicketScenario
  title            String
  description      String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  accountId        String
  account          Account        @relation("ReporterTickets", fields: [accountId], references: [id])
  relatedAccountId String?
  relatedAccount   Account?       @relation("RelatedTickets", fields: [relatedAccountId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([accountId])
  @@index([relatedAccountId])
  @@index([status])
}

model Policy {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  key           String   @unique
  title         String
  body          String
  tags          String[]
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([companyId])
}
