// Billing Resolution Agent — Milestone 1 data model.
// One fictional SaaS company ("Lumina Metrics, Inc.") with customer accounts,
// subscriptions, payments, invoices, support tickets, and billing policies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum TicketScenario {
  PAID_BUT_INACTIVE_PLAN
  DUPLICATE_INVOICE
  CROSS_ACCOUNT_EXPOSURE
  POSSIBLE_DOUBLE_CHARGE
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvestigationStatus {
  COMPLETED
  FAILED
}

enum UncertaintyLevel {
  CONFIRMED
  LIKELY
  UNCERTAIN
  UNRESOLVABLE
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NextStepType {
  PLATFORM_OPS_REACTIVATION
  DUPLICATE_INVOICE_VERIFICATION
  SECURITY_ESCALATION
  FINANCIAL_REVIEW
  CHARGE_VERIFICATION
}

model Company {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  accounts  Account[]
  policies  Policy[]
}

model Account {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  slug          String        @unique
  name          String
  billingEmail  String
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())

  subscriptions  Subscription[]
  payments       Payment[]
  invoices       Invoice[]
  tickets        Ticket[]       @relation("ReporterTickets")
  relatedTickets Ticket[]       @relation("RelatedTickets")

  @@index([companyId])
}

model Subscription {
  id                 String             @id @default(cuid())
  accountId          String
  account            Account            @relation(fields: [accountId], references: [id])
  key                String             @unique
  planName           String
  status             SubscriptionStatus
  seats              Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  // Bumped on every update; action proposals pin this value so an approval
  // against a record that changed after the proposal was written is rejected.
  updatedAt          DateTime           @updatedAt

  @@index([accountId])
}

model Payment {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  ref         String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  method      PaymentMethod
  status      PaymentStatus
  description String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  // Version evidence for action proposals (see Subscription.updatedAt).
  updatedAt   DateTime @updatedAt

  invoices Invoice[]

  @@index([accountId])
}

model Invoice {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  number      String        @unique
  paymentId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  status      InvoiceStatus
  periodStart DateTime?
  periodEnd   DateTime?
  issuedAt    DateTime
  notes       String?
  createdAt   DateTime @default(now())
  // Version evidence for action proposals (see Subscription.updatedAt).
  updatedAt   DateTime @updatedAt

  @@index([accountId])
}

model Ticket {
  id               String         @id @default(cuid())
  reference        String         @unique
  scenario         TicketScenario
  title            String
  description      String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(MEDIUM)
  accountId        String
  account          Account        @relation("ReporterTickets", fields: [accountId], references: [id])
  relatedAccountId String?
  relatedAccount   Account?       @relation("RelatedTickets", fields: [relatedAccountId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  investigations   Investigation[]
  proposals        ActionProposal[]
  escalations      TicketEscalation[]
  appliedActions   AppliedAction[]

  @@index([accountId])
  @@index([relatedAccountId])
  @@index([status])
}

model Policy {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  key           String   @unique
  title         String
  body          String
  tags          String[]
  effectiveFrom DateTime
  createdAt     DateTime @default(now())
  // Version evidence: an approval is invalidated when the policy changed
  // after the proposal pinned this timestamp.
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

// Milestone 2: persisted AI investigations. Advisory output for human review —
// no approvals, account mutations, refunds, or notifications are implemented.
model Investigation {
  id                     String              @id @default(cuid())
  ticketId               String
  ticket                 Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status                 InvestigationStatus
  provider               String
  model                  String
  isMock                 Boolean
  diagnosis              String?
  uncertainty            UncertaintyLevel?
  riskCategory           RiskCategory?
  proposedNextStepType   NextStepType?
  proposedNextStepDetail String?
  draftReply             String?
  supportingEvidence     Json?
  contradictingEvidence  Json?
  toolTrace              Json
  bounds                 Json
  policyOverrides        String[]
  failureReason          String?
  createdAt              DateTime            @default(now())
  proposal               ActionProposal?

  @@index([ticketId])
}

// Milestone 3: the only two synthetic mutations an authorized human can cause.
// A proposal is an immutable snapshot (evidence, target record versions, policy
// version, expiry) derived server-side from a completed investigation; the
// model cannot create one and cannot widen its scope.
enum ActionType {
  ENTITLEMENT_REPAIR
  DUPLICATE_INVOICE_CORRECTION
}

enum ProposalStatus {
  PROPOSED
  APPLIED
  REJECTED
  ESCALATED
}

enum ProposalDecision {
  APPROVED
  REJECTED
  ESCALATED
}

enum ProposalAuditEvent {
  PROPOSAL_CREATED
  DECISION_RECORDED
  APPROVAL_REJECTED
  APPLY_SUCCEEDED
  APPLY_FAILED
}

model ActionProposal {
  id              String           @id @default(cuid())
  ticketId        String
  ticket          Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  investigationId String           @unique
  investigation   Investigation    @relation(fields: [investigationId], references: [id])
  actionType      ActionType
  status          ProposalStatus   @default(PROPOSED)
  // Immutable payload: target record ids and the reporter account they belong to.
  payload         Json
  // Immutable snapshot of the investigation's supporting evidence citations.
  evidence        Json
  // Immutable `${recordType}:${id}` -> ISO updatedAt pins taken at creation.
  recordVersions  Json
  policyId        String
  policyKey       String
  // The policy's updatedAt when the proposal was written.
  policyVersion   String
  rationale       String
  expiresAt       DateTime
  decision        ProposalDecision?
  decidedBy       String?
  decidedAt       DateTime?
  appliedAt       DateTime?
  applyError      String?
  failureCount    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  audits          ProposalAudit[]
  appliedAction   AppliedAction?

  @@index([ticketId])
  @@index([status])
}

// Exactly-once ledger: the database itself forbids two applied actions of the
// same type for the same ticket, so concurrent approvals cannot double-apply.
model AppliedAction {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actionType ActionType
  proposalId String         @unique
  proposal   ActionProposal @relation(fields: [proposalId], references: [id])
  createdAt  DateTime       @default(now())

  @@unique([ticketId, actionType])
}

// Durable audit trail for the proposal workflow, including before/after
// evidence for every applied mutation and the reason for every rejection.
model ProposalAudit {
  id         String            @id @default(cuid())
  proposalId String
  proposal   ActionProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  event      ProposalAuditEvent
  actor      String?
  detail     Json?
  createdAt  DateTime          @default(now())

  @@index([proposalId])
}

// Escalation decisions for tickets whose route allows no account mutation
// (cross-account exposure, ambiguous double charge). The record itself is the
// audit entry; no account data is ever changed by an escalation.
model TicketEscalation {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  escalatedBy String
  note        String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
}
