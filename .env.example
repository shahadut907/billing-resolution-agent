# Copy this file to `.env` (repo root) and fill in your own local values.
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string used by Prisma (packages/db) and the API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Port the NestJS API listens on.
API_PORT=4000

# Base URL the frontend uses to reach the API (server-side fetches).
API_BASE_URL="http://127.0.0.1:4000/api"

# --- M2 AI investigation provider -------------------------------------------------
# AI_PROVIDER=mock (default) runs a deterministic, clearly labeled mock —
# no model is called. Set AI_PROVIDER=openai to use any OpenAI-compatible
# chat-completions API; then set AI_API_KEY and AI_MODEL (AI_BASE_URL optional).
# API keys stay in this git-ignored file / your shell — never commit them.
AI_PROVIDER="mock"
AI_MODEL=""
AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""

# Investigation bounds (defaults shown).
AGENT_TIME_BUDGET_MS=20000
AGENT_MAX_TOOL_CALLS=12

# --- M3 approval workflow ---------------------------------------------------------
# Reviewer passcode required for approve/reject/escalate decisions. There is NO
# default: if unset, decision endpoints are disabled (503). Set your own secret
# here (this file is an example only — put the real value in .env).
REVIEWER_PASSCODE=""
# Minutes an action proposal stays approvable after creation (default 30).
ACTION_PROPOSAL_TTL_MINUTES=30
# Set to 1 to turn the deployment into a public READ-ONLY preview: every
# mutating endpoint (investigation run, proposal, decision) answers 403.
PUBLIC_READ_ONLY=0
