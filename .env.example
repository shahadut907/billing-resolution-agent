# Copy this file to `.env` (repo root) and fill in your own local values.
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string used by Prisma (packages/db) and the API.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Port the NestJS API listens on.
API_PORT=4000

# Base URL the frontend uses to reach the API (server-side fetches).
API_BASE_URL="http://127.0.0.1:4000/api"
